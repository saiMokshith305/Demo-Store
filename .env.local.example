# Copy to .env.local and fill in with your Talon.One demo deployment values.
# Restart the dev server after editing — NEXT_PUBLIC_* vars are inlined at build time.

# Your deployment base URL, no trailing slash.
# Example: https://mycompany.europe-west1.talon.one
NEXT_PUBLIC_TALONONE_DEPLOYMENT_URL=https://tam.europe-west1.talon.one

# An Integration API key from Campaign Manager
# (Settings -> Developer settings -> API keys, for the Application you are demoing).
NEXT_PUBLIC_TALONONE_API_KEY=b2e746d8741305bfcc6022fb795f122980c91320c4c90914ff37a4c7ffa8823f
